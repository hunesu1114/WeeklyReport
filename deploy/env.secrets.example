# 서버의 ~/weekly-report/.env.secrets 템플릿.
#
# 이 파일의 값은 CI/CD 가 만들지 않는다. 서버에서 최초 1회 손으로 만들고 그대로 둔다.
#
# DB 비밀번호는 여기 없다. GitHub Secret POSTGRES_PASSWORD 가 원본이고
# CI 가 배포마다 .env.deploy 에 실어 내린다. 여기에 같은 키를 또 적으면
# .env.deploy 가 뒤에 와서 이기므로, 값만 어긋난 채 남아 사람을 헷갈리게 한다.
#
# 서버에서:
#   mkdir -p ~/weekly-report && cd ~/weekly-report
#   umask 077
#   이 내용을 .env.secrets 로 만들고 아래 값을 채운다
#   chmod 600 .env.secrets

# ---- PostgreSQL -----------------------------------------------------------
# 비밀번호가 아닌 이 둘은 compose 에 기본값이 있어 생략해도 된다.
# 적어두면 서버에서 무엇에 붙는지 한눈에 보인다.
POSTGRES_DB=weekly_report
POSTGRES_USER=weekly

# ---- 로그인 --------------------------------------------------------------
# JWT 서명 키. 비워두면 서버가 뜰 때마다 임시 키를 만들어
# 로그인한 사람이 전부 튕긴다. 반드시 채운다.
#   openssl rand -base64 32
#
# 이 값은 바꾸면 발급해둔 토큰이 전부 무효가 된다. 한 번 넣고 두는 이유다.
APP_JWT_SECRET=

# 토큰 유효기간. 기본 12시간.
APP_JWT_TTL=12h
